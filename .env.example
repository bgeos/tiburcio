# Copy to .env.local and fill in real values. Never commit .env.local.
# Placeholders only — this file is committed.

# Supabase project (local: printed by `npx supabase start`; hosted: Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# SERVER ONLY. Never prefix with NEXT_PUBLIC_ and never import from client code.
# Only needed for admin operations such as sending invitations (Phase 2+).
SUPABASE_SECRET_KEY=your-server-only-secret-key

# Public base URL of the app (used for auth redirects and invitation links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
